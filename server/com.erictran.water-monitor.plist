<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.erictran.water-monitor</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/erictran/Script/water-monitor/run_server.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/erictran/Script/water-monitor</string>

  <!-- Start the tmux session at login -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Re-check every 5 min and recreate the session if it was killed -->
  <key>StartInterval</key>
  <integer>300</integer>

  <key>StandardOutPath</key>
  <string>/tmp/water-monitor.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/water-monitor.err.log</string>
</dict>
</plist>
